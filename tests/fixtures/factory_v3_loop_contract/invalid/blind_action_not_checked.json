  "checkpoint_policy": {
    "cadence": "before and after each material action block",
    "required_fields": [
      "objective_status",
      "authority_status",
      "state_status",
      "tool_status",
      "verification_status",
      "open_decisions"
    ]
  },
  "control_profile": {
    "coverage_expectation": "All consequential actions must be represented in evidence.",
    "detection_mode": "asynchronous",
    "escalation_path": [
      "safe_hold",
      "human_decision",
      "fallback_to_v2"
    ],
    "prevention_gates": [
